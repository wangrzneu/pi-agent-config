FROM node:22-bookworm-slim@sha256:d649c27dae7ba0137b3cef5dd75baa422c08dc3d9e3fc0c23dfb172dc3cc6436

# Official Node.js Linux/arm64 distributions target glibc. A slim Debian base
# keeps that ABI stable while avoiding per-toolchain compatibility shims. Pin
# APT metadata to immutable, signed snapshots so rebuilds do not drift.
RUN printf '%s\n' \
    'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20260803T000000Z bookworm main' \
    'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian/20260803T000000Z bookworm-updates main' \
    'deb [check-valid-until=no] http://snapshot.debian.org/archive/debian-security/20260803T000000Z bookworm-security main' \
    > /etc/apt/sources.list \
  && rm -f /etc/apt/sources.list.d/debian.sources \
  && apt-get update \
  && apt-get install -y --no-install-recommends \
    bash \
    bubblewrap \
    ca-certificates \
    curl \
    git \
    ripgrep \
    socat \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/pi-sandbox
COPY package.json package-lock.json /opt/pi-sandbox/
RUN npm ci --omit=dev --no-audit --no-fund \
  && npm cache clean --force \
  && mkdir -p /opt/pi-runner /opt/pi-kube \
  && mv /usr/local/bin/node /opt/pi-runner/node \
  && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack

COPY guest-runner.mjs /opt/pi-sandbox/guest-runner.mjs

ENTRYPOINT ["/opt/pi-runner/node", "/opt/pi-sandbox/guest-runner.mjs"]
